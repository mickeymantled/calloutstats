<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<!--
  Callout Check: always-on local collector service (LaunchAgent, runs as the
  logged-in user). `npm run collector` = src/cli/collector.ts, listening on
  http://127.0.0.1:47831 (config.json collectorPort). It owns SQLite, parsing,
  export and publish; browser-side clients (the console script's POST /capture,
  or a client following docs/collector-protocol.md) only ship page text to it.

  This file is a template rendered by scripts/install-launchd.sh, which fills in
    absolute repo path        -> __REPO__
    directory of `node`       -> __NODE_BIN__
  and writes the result to ~/Library/LaunchAgents/com.calloutcheck.collector.plist.
  The node directory is prepended to PATH because a non-interactive `zsh -lc`
  reads ~/.zprofile but not ~/.zshrc; the collector also needs npm on PATH to
  spawn `npm run publish` after a run.

  RunAtLoad + KeepAlive: started at login and restarted whenever it exits, for any
  reason (ThrottleInterval keeps a crash loop to one restart every 10 s).
  Output: data/logs/collector.out.log and data/logs/collector.err.log; the
  collector's own log lines also go to data/logs/<date>.log via src/log.ts.

  The older com.calloutcheck.scrape.plist (Playwright, 06:00 daily) is the
  automated-browser path and is optional now; see scripts/install-launchd.sh.
-->
<dict>
  <key>Label</key>
  <string>com.calloutcheck.collector</string>

  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>-lc</string>
    <string>cd "__REPO__" &amp;&amp; npm run collector</string>
  </array>

  <key>RunAtLoad</key>
  <true/>

  <key>KeepAlive</key>
  <true/>

  <key>ThrottleInterval</key>
  <integer>10</integer>

  <key>WorkingDirectory</key>
  <string>__REPO__</string>

  <key>StandardOutPath</key>
  <string>__REPO__/data/logs/collector.out.log</string>
  <key>StandardErrorPath</key>
  <string>__REPO__/data/logs/collector.err.log</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>__NODE_BIN__:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
</dict>
</plist>
